{
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "import/no-cycle": "error",
    // Side-effect imports carry stylesheets and ambient type declarations.
    "import/no-unassigned-import": "off",
    // Sequential awaits in loops are deliberate: transactions and ordered fixtures.
    "eslint/no-await-in-loop": "off",
    // Spreading inside map keeps rows immutable; the cost is not measurable here.
    "oxc/no-map-spread": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    // Warn until the existing assertions are removed; then promote to error.
    "typescript/no-unsafe-type-assertion": "warn",
    // Helpers inside hooks and fakes read better next to their only caller.
    "unicorn/consistent-function-scoping": "off",
    // Array#toSorted needs the ES2023 lib, which the client does not target.
    "unicorn/no-array-sort": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.ts", "**/tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
