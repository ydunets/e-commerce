{
  "name": "@e-commerce/server",
  "version": "2.4.44",
  "description": "A Fastify template that follows the Clean Architecture principles and encourages established practices.",
  "author": "Marco Turi <marco.turi@hotmail.it>",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/src/*.js"
    },
    "#tests/*": {
      "development": "./tests/*.ts",
      "default": "./dist/tests/*.js"
    }
  },
  "scripts": {
    "create:env": "node -e \"require('fs').copyFileSync('.env.example', '.env', require('fs').constants.COPYFILE_EXCL)\"",
    "start": "pnpm --filter @e-commerce/contracts build && pnpm build && pnpm watch",
    "dev": "pnpm start",
    "start:prod": "node --enable-source-maps --import reflect-metadata --import ./dist/src/instrumentation.js ./dist/src/index.js",
    "test": "pnpm test:unit",
    "test:coverage": "pnpm build && c8 --exclude-after-remap --include 'src/**/*.ts' --exclude 'src/**/*.spec.ts' node --env-file-if-exists=.env --enable-source-maps --import reflect-metadata --test 'dist/src/**/*.spec.js' 'dist/tests/runtime/**/*.spec.js'",
    "test:unit": "pnpm build && node --env-file-if-exists=.env --enable-source-maps --import reflect-metadata --test 'dist/src/**/*.spec.js' 'dist/tests/runtime/**/*.spec.js'",
    "test:characterisation": "pnpm build && node --env-file-if-exists=.env --enable-source-maps --import reflect-metadata ./node_modules/@cucumber/cucumber/bin/cucumber.js --exit && node --env-file-if-exists=.env --enable-source-maps --import reflect-metadata --test 'dist/tests/runtime/*.integration.js'",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "type:check": "tsc --noEmit",
    "check": "pnpm run \"/^check:(lint|types|test|architecture)$/\"",
    "check:architecture": "pnpm deps:validate",
    "check:lint": "biome check",
    "check:test": "pnpm run test:unit",
    "check:types": "tsc --noEmit",
    "check:fix": "biome check --write && tsc --noEmit",
    "db": "dbmate h",
    "db:create-migration": "dbmate new",
    "db:migrate": "dbmate -e DBMATE_DATABASE_URL --no-dump-schema up",
    "db:create-seed": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ new",
    "db:seed": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ up",
    "deps:validate": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "deps:graph": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > doc/dependency-graph.svg",
    "semantic-release": "semantic-release",
    "build": "swc src tests -d dist --delete-dir-on-start --ignore '**/*.d.ts' --workers 2",
    "dev:compile": "swc src tests -d dist --ignore '**/*.d.ts' --workers 2 --watch",
    "dev:serve": "node --env-file-if-exists=.env --enable-source-maps --import reflect-metadata --import ./dist/src/instrumentation.js --watch ./dist/src/index.js",
    "watch": "pnpm run --parallel '/^dev:(compile|serve)$/'"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.3",
  "dependencies": {
    "@e-commerce/contracts": "workspace:*",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/otel": "0.19.0",
    "@fastify/request-context": "6.2.1",
    "@fastify/static": "10.1.2",
    "@fastify/under-pressure": "9.0.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/cqrs": "12.0.0",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation": "0.219.0",
    "@opentelemetry/instrumentation-http": "0.219.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.68.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "fastify": "5.12.1",
    "fastify-plugin": "5.1.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/html-formatter": "23.1.0",
    "@cucumber/messages": "32.3.1",
    "@cucumber/pretty-formatter": "3.3.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/node": "25.9.3",
    "c8": "10.1.3",
    "dbmate": "2.33.0",
    "dependency-cruiser": "17.4.3",
    "husky": "9.1.7",
    "pino-pretty": "13.1.3",
    "semantic-release": "25.0.5",
    "typescript": "7.0.2"
  },
  "keywords": [
    "fastify",
    "domain-driven-design",
    "functional-programming",
    "vertical-slice-architecture",
    "cucumber",
    "clean-architecture",
    "typescript",
    "template",
    "boilerplate"
  ],
  "files": ["dist/src", "!dist/src/**/*.spec.js", "!dist/src/**/*.spec.js.map"]
}
